{
  "name": "bs-spieleparadies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "check:clever": "rolldown scripts/check-clever.ts -o node_modules/.tmp-check.mjs -f esm -p node && node node_modules/.tmp-check.mjs",
    "check:intersections": "rolldown scripts/check-intersections.ts -o node_modules/.tmp-check-int.mjs -f esm -p node && node node_modules/.tmp-check-int.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "wrangler dev",
    "db:local": "wrangler d1 execute bs-spieleparadies --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute bs-spieleparadies --remote --file=./schema.sql",
    "words": "node scripts/build-words.mjs",
    "words:puzzle": "node scripts/build-wordpuzzle.mjs",
    "words:hangman": "node scripts/build-hangman.mjs",
    "words:intersections": "node scripts/build-intersections.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22"
  }
}
